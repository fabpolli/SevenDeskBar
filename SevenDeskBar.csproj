<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Progetto convertito dal formato Visual Studio 2012 (.NET 3.5) al formato SDK (.NET Framework 4.8).
    Compilazione senza Visual Studio:   dotnet build -c Release
    Output:                             bin\Release\net48\
    Il file di progetto originale e' conservato in SevenDeskBar.vs2012.csproj.bak
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SevenDeskBar</RootNamespace>
    <AssemblyName>SevenDeskBar</AssemblyName>
    <ApplicationIcon>SevenDeskBar.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>SevenDeskBar.Program</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- le risorse .resx contengono immagini: richiesto dal motore di build di dotnet -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <ItemGroup>
    <!-- copia storica dei sorgenti, non fa parte della compilazione -->
    <Compile Remove="Distribution\**" />
    <EmbeddedResource Remove="Distribution\**" />
    <None Remove="Distribution\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <Reference Include="System.Deployment" />
  </ItemGroup>
</Project>
